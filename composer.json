{
    "name": "shipperhq/module-shipping-tracker",

    "description": "Shipping Tracker - By the ShipperHQ Team",

    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],

    "version": "1.3.3",

    "authors": [
        {
            "name": "ShipperHQ",
            "email": "sales@shipperhq.com",
            "homepage": "http://www.Shipperhq.com"
        },
        {
            "name": "Karen Baker"
        }
    ],

    "type": "magento2-module",

    "support": {
        "documentation": "http://docs.shipperhq.com"
    },

    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "ShipperHQ\\Tracker\\": "src/"
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
